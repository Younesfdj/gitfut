# Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Live scouting and Redis are optional — without them the app serves baked sample cards.

# --- Live GitHub scouting (GraphQL) ---
# Fine-grained PAT: public repositories only, read-only. No private/org scopes.
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Or a comma-separated pool of tokens from distinct accounts (preferred in prod):
# GITHUB_TOKENS=tokA,tokB,tokC

# --- GitHub OAuth (optional — private-aware self-scout) ---
# Create an OAuth App at: https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Client ID + Client secret are shown on that app's page after you create it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random secret used to sign the session cookie (not from GitHub).
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# --- Redis (optional for public scouting; required for private README embeds ?k=) ---
# REDIS_URL=redis://localhost:6379
